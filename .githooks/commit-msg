#!/bin/sh
# Replace Cursor co-author trailer with Jahangir on every commit.
COMMIT_MSG_FILE=$1

if [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

# macOS and Linux compatible in-place edit
if sed --version >/dev/null 2>&1; then
  sed -i 's/Co-authored-by: Cursor <cursoragent@cursor.com>/Co-authored-by: Jahangir <jahangir_alam_99@hotmail.com>/g' "$COMMIT_MSG_FILE"
else
  sed -i '' 's/Co-authored-by: Cursor <cursoragent@cursor.com>/Co-authored-by: Jahangir <jahangir_alam_99@hotmail.com>/g' "$COMMIT_MSG_FILE"
fi

exit 0
