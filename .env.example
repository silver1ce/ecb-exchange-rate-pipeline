# Database (pick ONE option)
#
# Local without Docker (SQLite — recommended if Docker is unavailable):
DATABASE_URL=sqlite+aiosqlite:///./data/ecb_rates.db
#
# With Docker or local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://ecb_user:ecb_password@localhost:5432/ecb_rates

# ECB API configuration
ECB_BASE_URL=https://data-api.ecb.europa.eu/service/data/EXR
ECB_REQUEST_TIMEOUT=30
ECB_RETRY_ATTEMPTS=3

# Comma-separated ISO currency codes to filter ingestion (omit for all currencies)
# Example: USD,GBP,JPY
# DEFAULT_CURRENCIES=USD,GBP,JPY

# Application
LOG_LEVEL=INFO
APP_ENV=development
