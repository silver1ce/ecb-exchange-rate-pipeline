# PostgreSQL connection string (async driver required)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://ecb_user:ecb_password@localhost:5432/ecb_rates

# ECB API configuration
ECB_BASE_URL=https://data-api.ecb.europa.eu/service/data/EXR
ECB_REQUEST_TIMEOUT=30
ECB_RETRY_ATTEMPTS=3

# Comma-separated ISO currency codes to filter ingestion (empty = all currencies)
# Example: USD,GBP,JPY
DEFAULT_CURRENCIES=

# Application
LOG_LEVEL=INFO
APP_ENV=development
